{
  "schemaVersion": 1,
  "id": "kai.git-status",
  "name": "BCAD workspace",
  "version": "2.0.0",
  "author": "kai",
  "description": "Shows status of the BCAD multi-repo workspace and provides status, branches, pull, and push actions",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "BCAD workspace",
    "description": "Status, branches, pull, and push across workspace packages",
    "category": "Development",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "workspacePath": "~/BAS/bcad-ws"
    },
    "schema": [
      {
        "key": "workspacePath",
        "type": "string",
        "label": "Workspace path",
        "description": "Directory containing packages.json and packages/"
      }
    ]
  }
}
